{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Orchid operator remoteControl observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "nativeSessionId",
    "host",
    "paneId",
    "workspaceId",
    "vendor",
    "state",
    "reason",
    "sessionName",
    "link",
    "observedAt",
    "validUntil"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^orchid-[a-f0-9]{64}$"
    },
    "nativeSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "paneId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "enum": [
        "claude",
        "chatgpt"
      ]
    },
    "state": {
      "enum": [
        "connected",
        "unconfirmed"
      ]
    },
    "reason": {
      "enum": [
        null,
        "remote-control-unconfirmed"
      ]
    },
    "sessionName": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 192
    },
    "link": {
      "description": "Claude Remote Control session URL, or null. An OBSERVED, undocumented association: served only when Claude Code's own per-process session record (bridgeSessionId) and the latest bridge_status entry of that session's transcript agree, for the launched process while it is alive. The URL form is documented (the session id is the part of the claude.ai/code session URL after /code/). Identity only, never a connection verdict; never derived from terminal text. Null whenever either source is missing, malformed or disagrees, or the session ended or changed.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://claude\\.ai/code/session_[A-Za-z0-9]{1,128}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "vendor": {
            "const": "chatgpt"
          }
        }
      },
      "then": {
        "properties": {
          "link": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vendor": {
            "const": "claude"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "unconfirmed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "connected"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "unconfirmed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "remote-control-unconfirmed"
          },
          "sessionName": {
            "type": "null"
          }
        }
      }
    }
  ]
}
