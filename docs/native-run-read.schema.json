{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchid native run private wire version 2",
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "label": {
          "type": "string",
          "pattern": "^(codex|codex-run|claude|agy|opencode|opencode-run)-[1-9][0-9]{0,15}$"
        }
      },
      "required": [
        "key",
        "label"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "machine": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "host",
        "session",
        "machine"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "instant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "at",
        "generation"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "issue": {
          "$ref": "#/$defs/issue"
        },
        "dispatchKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nativeSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent": {
          "enum": [
            "codex",
            "codex-run",
            "claude",
            "agy",
            "opencode",
            "opencode-run"
          ]
        },
        "label": {
          "type": "string",
          "pattern": "^(codex|codex-run|claude|agy|opencode|opencode-run)-[1-9][0-9]{0,15}$"
        },
        "phase": {
          "enum": [
            "active",
            "completed"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agent_"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^assignment_"
        },
        "sourceCommentId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "launch": {
          "$ref": "#/$defs/instant"
        },
        "taskStart": {
          "$ref": "#/$defs/instant"
        }
      },
      "required": [
        "key",
        "issue",
        "dispatchKey",
        "nativeSessionId",
        "agent",
        "label",
        "phase",
        "observedAt",
        "scope",
        "agentId",
        "assignmentId",
        "sourceCommentId"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "completedAt"
            ]
          },
          "else": {
            "not": {
              "required": [
                "completedAt"
              ]
            }
          }
        }
      ]
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "reason": {
          "enum": [
            "run_not_found",
            "binding_unavailable",
            "identity_mismatch",
            "native_identity_unavailable",
            "source_unavailable"
          ]
        }
      },
      "required": [
        "key",
        "reason"
      ]
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "run_lookup"
        },
        "schemaVersion": {
          "const": 2
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "maxItems": 128
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missing"
          },
          "maxItems": 128
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "generation",
        "revision",
        "observedAt",
        "complete",
        "records",
        "missing"
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "subscription_started"
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "generation",
        "revision"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "runs_changed"
            },
            "generation": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "generation",
            "revision"
          ]
        }
      },
      "required": [
        "event"
      ]
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "method": {
              "const": "run.lookup"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keys": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/query"
                  },
                  "maxItems": 128
                }
              },
              "required": [
                "keys"
              ]
            }
          },
          "required": [
            "id",
            "method",
            "params"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "method": {
              "const": "run.subscribe"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "id",
            "method",
            "params"
          ]
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "result": {
              "$ref": "#/$defs/lookup"
            }
          },
          "required": [
            "id",
            "result"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "result": {
              "$ref": "#/$defs/ack"
            }
          },
          "required": [
            "id",
            "result"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "source_unavailable"
                }
              },
              "required": [
                "code"
              ]
            }
          },
          "required": [
            "id",
            "error"
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ]
}
